{
  "name": "moviehub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node scripts/snapshot.cjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "reactSnap": {
    "source": "dist",
    "publicPath": "/",
    "include": [
      "/",
      "/movies",
      "/tv"
    ],
    "crawl": false,
    "minifyHtml": false,
    "minifyCss": false,
    "fixWebpackChunksIssue": false,
    "skipThirdPartyRequests": false
  },
  "dependencies": {
    "lucide-react": "^1.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sparticuz/chromium": "^149.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "react-snap": "^1.23.0",
    "vite": "^8.1.1"
  }
}
